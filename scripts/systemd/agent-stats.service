[Unit]
Description=Agent Stats Claude Code telemetry receiver
After=network.target

[Service]
Type=simple
User=agent-stats
Group=agent-stats-read
ExecStart=/usr/local/bin/agent-stats serve --config /etc/agent-stats/agent-stats.toml
UMask=0077
StateDirectory=agent-stats
StateDirectoryMode=0700
RuntimeDirectory=agent-stats
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
